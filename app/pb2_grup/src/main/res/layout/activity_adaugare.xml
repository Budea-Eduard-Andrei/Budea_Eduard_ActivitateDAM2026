<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AdaugareActivity">

    <EditText
        android:id="@+id/budea_eduard_et_ID"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/precizeaza_id_tableta"/>

    <EditText
        android:id="@+id/budea_eduard_et_memorie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/precizeaza_memorie"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/selecteaza_modelul_tabletei"/>
    <Spinner
        android:id="@+id/budea_eduard_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:entries="@array/lista_modele"/>

    <CheckBox
        android:id="@+id/budea_eduard_cb_wireless"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/are_wireless_charging"/>

    <Button
        android:id="@+id/budea_eduard_btn_salveaza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/salveaza_tableta"/>

</LinearLayout>