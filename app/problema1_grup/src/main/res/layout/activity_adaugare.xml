<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AdaugareActivity">
    
    <EditText
        android:id="@+id/eduard_andrei_et_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/id_incarcator"/>
    
    <EditText
        android:id="@+id/eduard_andrei_et_pret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/introdu_pretul"/>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/alege_culoarea_incarcatorului"/>
    <RadioGroup
        android:id="@+id/eduard_andrei_rg_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <RadioButton
            android:id="@+id/eduard_andrei_rb_alb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/incarcator_alb"/>

        <RadioButton
            android:id="@+id/eduard_andrei_rb_negru"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/incarcator_negru"/>
    </RadioGroup>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/alege_producator"/>
    <Spinner
        android:id="@+id/eduard_andrei_sp_producator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:entries="@array/lista_producatori"/>

    <Button
        android:id="@+id/eduard_andrei_btn_salvare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/salveaza_incarcatorul"/>


</LinearLayout>