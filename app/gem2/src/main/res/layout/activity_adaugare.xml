<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AdaugareActivity">

    <EditText
        android:id="@+id/budea_eduard_et_ID"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/precizeaza_id_ul"/>

    <EditText
        android:id="@+id/budea_eduard_et_Marca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/precizeaza_marca"/>

    <CheckBox
        android:id="@+id/budea_eduard_cb_asigurare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/are_asigurare"/>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ofera_rating"/>
    <RatingBar
        android:id="@+id/budea_eduard_rb_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/budea_eduard_btn_salvare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/salveaza_masina"/>

</LinearLayout>