<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AdaugareZbor">

    <EditText
        android:id="@+id/budea_eduard_et_ID"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/precizeaza_id"/>

    <EditText
        android:id="@+id/budea_eduard_et_pret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/precizeaza_pret"/>

    <Switch
        android:id="@+id/budea_eduard_switch_cazare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/asigura_cazare"
        android:layout_marginTop="16dp"/>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/selecteaza_destinatia"/>
    <RadioGroup
        android:id="@+id/budea_eduard_rg_destinatie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bali"/>
        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/spania"/>
        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/romania"/>
    </RadioGroup>

    <Button
        android:id="@+id/budea_eduard_btn_salveaza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/salveaza_zborul"/>


</LinearLayout>